    {
      "parameters": {
        "jsCode": "const ctx = $items('Preparar Contexto Odoo', 0, 0).json;\nconst partners = $json.result || [];\nconst existing = partners[0];\n\nreturn [{\n  ...ctx,\n  partner_id: existing?.id || null\n}];"
      },
