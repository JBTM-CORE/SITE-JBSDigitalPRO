    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\nconst required = ['nome', 'whatsapp', 'email', 'servico'];\nconst missing = required.filter((field) => {\n  const value = body[field];\n  return value === undefined || value === null || String(value).trim() === '';\n});\n\nif (missing.length) {\n  return [{\n    valid: false,\n    statusCode: 400,\n    message: `Campos obrigatórios ausentes: ${missing.join(', ')}`,\n    data: body\n  }];\n}\n\nfunction normalizePhone(input) {\n  const digits = String(input).replace(/\\D/g, '');\n  if (!digits) return '';\n\n  let normalized = digits;\n  if (normalized.startsWith('55')) {\n    normalized = `+${normalized}`;\n  } else if (normalized.length >= 10) {\n    normalized = `+55${normalized}`;\n  } else {\n    normalized = `+${normalized}`;\n  }\n\n  return normalized;\n}\n\nfunction normalizeEmail(input) {\n  return String(input || '').trim().toLowerCase();\n}\n\nfunction normalizeText(input) {\n  return String(input || '')\n    .trim()\n    .replace(/\\s+/g, ' ');\n}\n\nconst nome = normalizeText(body.nome);\nconst whatsapp = normalizePhone(body.whatsapp);\nconst email = normalizeEmail(body.email);\nconst servico = normalizeText(body.servico).toLowerCase();\nconst mensagem = normalizeText(body.mensagem || body.message || '');\n\nconst serviceToTag = {\n  webdesign: 'webdesign',\n  marketing: 'marketing',\n  ia: 'ia',\n  chatbot: 'chatbot',\n  odoo: 'odoo',\n  n8n: 'n8n',\n};\n\nconst normalizedService = Object.keys(serviceToTag).find((key) => servico.includes(key)) || servico;\nconst tags = [];\nif (serviceToTag[normalizedService]) tags.push(serviceToTag[normalizedService]);\n\nreturn [{\n  valid: true,\n  statusCode: 200,\n  source: 'Site JBS DigitalPRO',\n  nome,\n  whatsapp,\n  email,\n  servico: normalizedService,\n  mensagem,\n  tags,\n  raw: body\n}];"
      },
      "id": "2",
      "name": "Validar e Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -740,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.valid }}",
              "value2": true
            }
          ]
        }
