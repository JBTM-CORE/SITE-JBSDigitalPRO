        "url": "={{ $env.ODOO_BASE_URL }}/jsonrpc",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ jsonrpc: '2.0', method: 'call', params: { service: 'common', method: 'login', args: [$env.ODOO_DB, $env.ODOO_USERNAME, $env.ODOO_PASSWORD] }, id: Date.now() }) }}",
        "options": {}
      },
      "id": "5",
      "name": "Odoo Login",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -280,
        20
      ]
    },
    {
      "parameters": {
        "jsCode": "const uid = $json.result;\nif (!uid) throw new Error('Falha ao autenticar no Odoo.');\n\nconst lead = $items('Validar e Normalizar', 0, 0).json;\n\nreturn [{\n  uid,\n  source: lead.source,\n  nome: lead.nome,\n  whatsapp: lead.whatsapp,\n  email: lead.email,\n  servico: lead.servico,\n  mensagem: lead.mensagem,\n  tags: lead.tags,\n}];"
      },
      "id": "6",
      "name": "Preparar Contexto Odoo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        20
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.ODOO_BASE_URL }}/jsonrpc",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ jsonrpc: '2.0', method: 'call', params: { service: 'object', method: 'execute_kw', args: [ $env.ODOO_DB, $json.uid, $env.ODOO_PASSWORD, 'res.partner', 'search_read', [[['email', '=', $json.email]]], { fields: ['id', 'name', 'email', 'mobile'], limit: 1 } ] }, id: Date.now() }) }}",
        "options": {}
      },
      "id": "7",
      "name": "Buscar Contato",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
